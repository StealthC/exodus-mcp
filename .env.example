# exodus-mcp local configuration.
# Copy this file to .env (git-ignored) and adjust the values. Every variable
# uses one precedence chain across scripts, launchers, and flags:
#
#   explicit flag > environment variable > .env > built-in default
#
# Paths must be Windows-style because the wrappers execute through cmd.exe.

# Required for build/run: Exodus install root (contains Exodus*.exe,
# Plugins/, settings.xml).
EXODUS_MCP_EXODUS_DIR=F:\projects\kid\emulators\Exodus_2.1

# Optional: emulator executable. Either a file name inside
# EXODUS_MCP_EXODUS_DIR or an absolute path. Default: Exodus.exe
EXODUS_MCP_EXODUS_EXE=Exodus.nightly.exe

# Optional: plugin install directory override.
# Default: %EXODUS_MCP_EXODUS_DIR%\Plugins
#EXODUS_MCP_PLUGINS_DIR=

# Optional: MCP HTTP endpoint address (mirrors --listen).
# Default: 127.0.0.1:8767
#EXODUS_MCP_LISTEN=127.0.0.1:8767

# Optional: artifact store directory (mirrors --artifacts).
# Default: %TEMP%\exodus-mcp\artifacts
#EXODUS_MCP_ARTIFACTS=

# Optional: retention lifetime for tool artifacts (mirrors --artifact-ttl, a
# Go duration such as 24h or 30m). Background expiry removes artifacts older
# than the TTL; leave unset (0) to keep artifacts for the whole server
# session.
#EXODUS_MCP_ARTIFACT_TTL=24h

# Optional: directory anchoring context-scoped system snapshots created by
# state_save (mirrors --states).
# Default: %TEMP%\exodus-mcp\states
#EXODUS_MCP_STATES_DIR=

# Optional: directory containing the experiment scripts and fixtures executed
# by experiment_run (mirrors --scripts). Only plain .py/.json file names are
# accepted. The launcher defaults this to <repo>\scripts\experiments.
#EXODUS_MCP_SCRIPTS_DIR=

# Optional: Python 3 interpreter used for .py experiment scripts (mirrors
# --python). Default: python on Windows, python3 elsewhere.
#EXODUS_MCP_PYTHON=

# Optional: manual bridge attachment when running exodus-mcp.exe without the
# launcher. The launcher mode generates these automatically and never logs
# them.
#EXODUS_MCP_PIPE_NAME=
#EXODUS_MCP_CAPABILITY=
